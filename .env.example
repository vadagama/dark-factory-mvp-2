# Локальное зеркало секретов (не коммитится; агентам запрещено читать значения).
# Источник имён ключей для ссылок в декларациях — только имена, значения подставляются
# в момент исполнения (ADR-0011: секреты вне git). Скопируйте в .env и заполните локально.

# DSH: доступ ядра к движку исполнения (SDK за адаптером, ADR-0001)
DSH_API_TOKEN=

# VCS: machine-аккаунт фабрики (GitLab-first, Q4); без scope merge/production (ADR-0006)
FACTORY_VCS_TOKEN=

# Секрет-хранилище: подстановка значений в момент исполнения
SECRET_STORE_URL=
